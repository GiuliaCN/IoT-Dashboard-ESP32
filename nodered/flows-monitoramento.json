    {
        "id": "90c64821c69d5c79",
        "type": "function",
        "z": "e9659ae1b082b20b",
        "name": "function Processar estado",
        "func": "const data = msg.payload;\nconst agora = new Date();\n\nlet estadoAtual = context.get(\"estadoAtual\");\nlet ultimaMudanca = context.get(\"ultimaMudanca\");\nlet historico = context.get(\"historico\") || [];\nlet grafico = context.get(\"grafico\") || [];\nif (!ultimaMudanca) {\n    ultimaMudanca = agora.toISOString();\n    context.set(\"ultimaMudanca\", ultimaMudanca);\n}\n\nconst segundos = Math.floor(\n    (agora.getTime() - new Date(ultimaMudanca).getTime()) / 1000\n);\nconst primeiraLeitura = estadoAtual === undefined;\nconst mudou = !primeiraLeitura && data.vibrando !== estadoAtual;\n\nif (primeiraLeitura || mudou) {\n    estadoAtual = data.vibrando;\n    ultimaMudanca = agora.toISOString();\n\n    const evento = {\n        horario: agora.toLocaleTimeString(\"pt-BR\"),\n        evento: data.vibrando ? \"Ligou\" : \"Desligou\",\n        dispositivo: data.deviceId || \"maquina-01\"\n    };\n\n    historico.unshift(evento);\n    historico = historico.slice(0, 10);\n\n    context.set(\"estadoAtual\", estadoAtual);\n    context.set(\"ultimaMudanca\", ultimaMudanca);\n    context.set(\"historico\", historico);\n}\n\ngrafico.push({\n    x: agora.getTime(),\n    y: data.vibrando ? 1 : 0\n});\n\ngrafico = grafico.slice(-30);\ncontext.set(\"grafico\", grafico);\n\nconst statusMsg = {\n    payload: data.vibrando ? \"🟢 MÁQUINA LIGADA\" : \"🔴 MÁQUINA DESLIGADA\"\n};\n\nconst tempoMsg = {\n    payload: `${segundos} segundos no estado atual`\n};\n\nconst chartMsg = {\n    payload: data.vibrando ? 1 : 0,\n    topic: \"Vibração\"\n};\n\nconst historicoMsg = {\n    payload: historico\n};\n\nconst respostaHttpMsg = RED.util.cloneMessage(msg);\n\nrespostaHttpMsg.payload = {\n    ok: true,\n    status: data.vibrando ? \"LIGADA\" : \"DESLIGADA\",\n    tempoEstadoAtualSegundos: segundos\n};\n\nreturn [\n    { payload: data.vibrando ? \"🟢 MÁQUINA LIGADA\" : \"🔴 MÁQUINA DESLIGADA\" },\n    { payload: `${segundos} segundos no estado atual` },\n    { payload: data.vibrando ? 1 : 0, topic: \"Vibração\" },\n    { payload: historico },\n    respostaHttpMsg\n];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
